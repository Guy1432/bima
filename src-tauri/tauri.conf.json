{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bima",
  "version": "0.9.0",
  "identifier": "com.bima.projector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "בימה",
        "width": 1480,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "maximized": true,
        "backgroundColor": "#09090b",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$APPDATA/media/*"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Bima",
    "shortDescription": "Bima - Hebrew presentation & projection",
    "longDescription": "Professional dual-screen projection for presentations, PDF, video, YouTube and live text slides.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Hebrew",
          "English"
        ],
        "displayLanguageSelector": false,
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5NzUzQ0NBMDZDRjc4MEYKUldRUGVNOEd5angxT1ZoRzZ4aHU5QkNvMmZHUXZpTTZXL0d5WW5QaDYyMXNybk5vdllJQllMbm0K",
      "endpoints": [
        "https://github.com/Guy1432/bima/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
